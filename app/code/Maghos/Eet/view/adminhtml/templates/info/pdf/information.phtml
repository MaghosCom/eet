/** @var \Maghos\Eet\Block\Payment\Info\Specific $block */
/** @var \Magento\Framework\Escaper $escaper */
$specificInfo = $block->getSpecificInformation();
?>
<?php if ($specificInfo): ?>
    <?php foreach ($specificInfo as $label => $value): ?>
        <?= $escaper->escapeHtml($label) ?>:
        <?= $escaper->escapeHtml(is_array($value) ? implode(' ', $value) : $value) ?>
        {{pdf_row_separator}}
    <?php endforeach; ?>
<?php endif; ?>
