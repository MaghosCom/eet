<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <listingToolbar name="listing_top">
        <massaction name="listing_massaction">
            <action name="eet_resend">
                <settings>
                    <url path="imaghoseet/creditmemo/massResend"/>
                    <type>eet_resend</type>
                    <label translate="true">Resend EET</label>
                    <confirm>
                        <title translate="true">Resend EET</title>
                        <message translate="true">Send again the EET receipts of the selected items that were not sent?</message>
                    </confirm>
                </settings>
            </action>
        </massaction>
    </listingToolbar>
    <columns name="sales_order_creditmemo_columns">
        <column name="eet_status" component="Magento_Ui/js/grid/columns/select" sortOrder="200">
            <settings>
                <filter>select</filter>
                <options class="Maghos\Eet\Model\Source\RecordStatus"/>
                <dataType>select</dataType>
                <label translate="true">EET</label>
            </settings>
        </column>
    </columns>
</listing>
