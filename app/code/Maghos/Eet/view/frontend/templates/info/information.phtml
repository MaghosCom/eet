/** @var \Maghos\Eet\Block\Payment\Info\Specific $block */
/** @var \Magento\Framework\Escaper $escaper */
$specificInfo = $block->getSpecificInformation();
?>
<?php if ($specificInfo): ?>
    <dl class="payment-method-info">
    <?php foreach ($specificInfo as $label => $value): ?>
        <dt class="title"><?= $escaper->escapeHtml($label) ?>:</dt>
        <dd class="content">
            <?= /* @noEscape */ nl2br($escaper->escapeHtml(is_array($value) ? implode("\n", $value) : $value)) ?>
        </dd>
    <?php endforeach; ?>
    </dl>
<?php endif; ?>
